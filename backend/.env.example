# Copy to backend/.env. Both keys are optional: without them the server runs the offline persona and cache-only voice.
OPENAI_KEY=
ELEVENLABS_API_KEY=
# normal | offline | scripted | headless
HAP_MODE=normal
# 1 = short betting/between/round timers for unattended runs
HAP_FAST_TIMERS=0
# 1 = enable /remote?fake=1 synthetic motion UI
HAP_DEV=1
# Public base URL baked into QR codes (host page can override at runtime)
HAP_PUBLIC_URL=http://localhost:5173
